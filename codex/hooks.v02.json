{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/vl.js\" hook start --agent codex",
            "timeout": 60,
            "statusMessage": "verify-layer: capturing request"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/vl.js\" hook stop --agent codex",
            "timeout": 60,
            "statusMessage": "verify-layer: checking request"
          }
        ]
      }
    ]
  }
}
