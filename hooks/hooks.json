{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "if": "Skill(verify)",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/vl.js", "hook", "run", "verify"],
            "timeout": 10,
            "onFailure": "continue"
          },
          {
            "type": "command",
            "if": "Skill(code-review)",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/vl.js", "hook", "run", "code-review"],
            "timeout": 10,
            "onFailure": "continue"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/vl.js", "hook", "commit"],
            "timeout": 10,
            "onFailure": "continue"
          },
          {
            "type": "command",
            "if": "PowerShell(git commit *)",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/vl.js", "hook", "commit"],
            "timeout": 10,
            "onFailure": "continue"
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "matcher": "(^|:)(verify|code-review|review)$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/vl.js", "hook", "expand"],
            "timeout": 10,
            "onFailure": "continue"
          }
        ]
      }
    ]
  }
}
